{
  "manifest_version": 3,
  "name": "Smart Reload",
  "version": "1.1.2",
  "description": "操作中や再生中は自動で見送り、変化したときだけ更新する自動リロード。スクロール位置と入力内容も復元します。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Smart Reload",
    "default_icon": {
      "16": "icons/icon-off16.png",
      "32": "icons/icon-off32.png",
      "48": "icons/icon-off48.png",
      "128": "icons/icon-off128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/shared.js", "src/content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "tabs", "scripting", "notifications"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "commands": {
    "toggle-reload": {
      "description": "このタブの自動リロードを切り替える"
    }
  }
}
